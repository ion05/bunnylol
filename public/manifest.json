{
  "manifest_version": 3,
  "name": "BunnyLol",
  "version": "1.1.0",
  "description": "Keyword shortcuts for your address bar. Type gh facebook/react and go straight there.",
  "homepage_url": "https://github.com/ion05/bunnylol",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*"
  ],
  "omnibox": {
    "keyword": "bl"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BunnyLol",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["go.html"],
      "matches": [
        "https://www.google.com/*",
        "https://www.bing.com/*",
        "https://duckduckgo.com/*"
      ]
    }
  ]
}
